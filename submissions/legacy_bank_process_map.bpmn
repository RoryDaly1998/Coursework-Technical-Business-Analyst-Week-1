<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1rtz0du" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_0e9loob">
    <bpmn:participant id="Participant_0u0r6pu" processRef="Process_0eww5qp" />
    <bpmn:textAnnotation id="TextAnnotation_1698sh2">
      <bpmn:text>If account is not updated accurately then might be wrongly included/excluded from report</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_02dsw96">
      <bpmn:text>Account may not be updated accurately so could have incorrect status</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0q0gsu8">
      <bpmn:text>Time consuming and gives rise to human error</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0z351is">
      <bpmn:text>If customer has already been called then time is wasted and effort is duplicated and occasionally breaches contact rules</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1r7gj0p">
      <bpmn:text>Needing to update across multiple sources can create discrepancies and is time consuming</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_16z6lsq">
      <bpmn:text>Manually updating records is time consuming and can create discrepancies between sources</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1qo003k">
      <bpmn:text>Miss the flag and the account pops back up and gets a chasing call for money that's already promised</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0ci9wil">
      <bpmn:text>There's no system prompt for checking arrangement fulfillment - agents must remember on their own</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1p01x8r">
      <bpmn:text>poor visibility of promise-to-pay fulfilment</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1nnkwj1">
      <bpmn:text>Details must be manually updated across multiple sources - can lead to discrepancies</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1bqh8ng" associationDirection="None" sourceRef="Activity_1o0t357" targetRef="TextAnnotation_1698sh2" />
    <bpmn:association id="Association_185gngr" associationDirection="None" sourceRef="Activity_08rw9pa" targetRef="TextAnnotation_02dsw96" />
    <bpmn:association id="Association_14pn2tg" associationDirection="None" sourceRef="Activity_02jbmva" targetRef="TextAnnotation_0q0gsu8" />
    <bpmn:association id="Association_1h1p6fl" associationDirection="None" sourceRef="Activity_092fg6j" targetRef="TextAnnotation_0z351is" />
    <bpmn:association id="Association_1gm8vkc" associationDirection="None" sourceRef="Activity_088enx9" targetRef="TextAnnotation_1r7gj0p" />
    <bpmn:association id="Association_0l8fc3y" associationDirection="None" sourceRef="Activity_06ygtk1" targetRef="TextAnnotation_16z6lsq" />
    <bpmn:association id="Association_0h8xnx2" associationDirection="None" sourceRef="Activity_1b9qy95" targetRef="TextAnnotation_1qo003k" />
    <bpmn:association id="Association_0m6ijj7" associationDirection="None" sourceRef="Activity_0yagbok" targetRef="TextAnnotation_0ci9wil" />
    <bpmn:association id="Association_0q2a4cw" associationDirection="None" sourceRef="TextAnnotation_1p01x8r" targetRef="Activity_0yagbok" />
    <bpmn:association id="Association_18rw2ip" associationDirection="None" sourceRef="TextAnnotation_1nnkwj1" targetRef="Activity_00qa5xy" />
    <bpmn:textAnnotation id="TextAnnotation_185dg0h">
      <bpmn:text>If an agent forgets to follow up then broken arrangements slip through the cracks</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_00vn7hu" associationDirection="None" sourceRef="Activity_0yagbok" targetRef="TextAnnotation_185dg0h" />
    <bpmn:textAnnotation id="TextAnnotation_0eso4qf">
      <bpmn:text>Waiting for a customer to answer is time consuming. It could take hours to get a response</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0s6dcid" associationDirection="None" sourceRef="Gateway_1t01vsm" targetRef="TextAnnotation_0eso4qf" />
  </bpmn:collaboration>
